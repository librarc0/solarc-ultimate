# Copy this file to .env before running Docker Compose.

# Required: generate a unique random value for production.
SECRET_KEY=replace-with-openssl-rand-hex-32

# JSON array string. Keep localhost values for local development.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Optional email password reset settings. Leave blank to disable email reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:8080

# Optional WeChat mini-program settings.
WX_APP_ID=
WX_APP_SECRET=
